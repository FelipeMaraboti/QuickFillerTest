generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transcricao {
  id         String   @id @default(cuid())
  tipo       String
  status     String   // processando, concluido, erro
  erro       String?
  value      String?
  progresso  String?  // JSON: { paginaAtual, totalPaginas, etapa, tempoEstimado }
  filePath   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
